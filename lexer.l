/*
 * =================================================================
 * lexer.l  --  Lexical Analyser
 * SE2052 Programming Paradigms
 *
 * What the Lexer Does:
 * Reads the raw input text character by character and groups
 * characters into meaningful units called TOKENS.
 *
 * Example:
 *   Input text :  TASK backupDB {
 *   Tokens out :  [TASK]  [IDENTIFIER:"backupDB"]  [LBRACE]
 *
 * ================================================================
 */


/* ================================================================
   SECTION 1 -- DEFINITIONS
   ================================================================
   Two things here:
     1. C code inside %{ ... %} -- copied directly to lex.yy.c
     2. Named pattern macros    -- regex shortcuts for Section 2
   ================================================================ */

%{
/*
 * Standard headers and the parser token definitions.
 *
 * parser.tab.h is generated by "yacc -d parser.y" (or "bison -d").
 * In classic Yacc this file was called y.tab.h.
 * With Bison the equivalent output is parser.tab.h.
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "parser.tab.h"

/*
 * line_num - tracks the current line number in the input.

 */
int line_num = 1;
%}

/*
 * Named Pattern Definitions
 * ---------------------------------------------------------------------------
 * Syntax:   NAME    regex
 * Use in rules section as: {NAME}
 */

/* A single digit 0 to 9 */
DIGIT       [0-9]

/* Any upper or lowercase letter */
LETTER      [a-zA-Z]

/*
 * Identifier: starts with a letter, then any mix of
 * letters, digits, or underscores.
 */
ID          {LETTER}({LETTER}|{DIGIT}|_)*

/*
 * 24-hour time value: exactly 2 digits, colon, 2 more digits.
 * Matches: 06:00   14:30   23:59   00:00
 */
TIME_PAT    {DIGIT}{DIGIT}:{DIGIT}{DIGIT}

/*
 * Quoted string: opening quote, any non-quote characters, closing quote.
 * Matches: "backup.sh"   "report.py"   "deploy.sh"
 * The \" inside the regex means a literal double-quote character.
 */
STR_PAT     \"[^\"]*\"

/*
 * Comment: Hash symbol followed by anything up to the end of line.
 */
COMMENT     #[^\n]*


/* ================================================================
   SECTION 2 -- RULES
   ================================================================
   Format :     pattern     { action }

   CRITICAL RULE:
   "If two rules match the same string at the same length,
    Lex chooses the rule that was DEFINED FIRST."

   ================================================================ */

%%

    /* ---- skip comment lines(# to end of line) ------ */
{COMMENT}        { /* ignore -- do nothing */ }

    /* ---- skip spaces and tabs----- */
[ \t\r]+         { /* ignore whitespace */ }

    /*
     * Count newlines MANUALLY -- the classic Lex way (Lec4).
     * I increment line_num so error messages can show the line.
     * (Flex has %option yylineno to do this automatically, but
     *   used the standard Lex technique.)
     */

\n              { line_num++; }


    /* ============================================================
       KEYWORD TOKENS
       ============================================================ */

"TASK"          { return TASK;    }
"RUN"           { return RUN;     }
"EVERY"         { return EVERY;   }
"DAY"           { return DAY;     }
"WEEK"          { return WEEK;    }
"AT"            { return AT;      }
"ON"            { return ON;      }
"AFTER"         { return AFTER;   }
"BEFORE"        { return BEFORE;  }
"DEPENDS"       { return DEPENDS; }

    /*
     * IF conflicts with C's own keyword, so the token is named IF_KW.
     * This avoids a name clash in the generated C code .
     */
"IF"            { return IF_KW;   }

    /* condition keywords are lowercase as per the assignment spec */
"success"       { return SUCCESS; }
"failure"       { return FAILURE; }


    /* ============================================================
       TOKENS WITH VALUES
       ============================================================ */

    /*
     * IDENTIFIER: task names like backupDB, sendReport, cleanup.
     * Must appear AFTER all keyword rules.
     */
{ID}             {
                    yylval.str = strdup(yytext);
                    return IDENTIFIER;
                 }

    /* TIME_VAL: 24-hour time strings like 06:00, 23:30, 14:45 */
{TIME_PAT}      {
                    yylval.str = strdup(yytext);
                    return TIME_VAL;
                }

    /* STRING: quoted script names like "backup.sh", "report.py" */
{STR_PAT}       {
                    yylval.str = strdup(yytext);
                    return STRING;
                }


    /* ---- PUNCTUATION TOKENS ---- */
"{"              { return LBRACE; }
"}"              { return RBRACE; }


    /* =============================================================
       CATCH-ALL
       The dot (.) matches ANY single character not matched above.
       This catches typos and invalid characters in the input.
       yytext holds the unrecognised character(as a string)
       line_num tell which line the error occurred on.
       ============================================================ */
.               {
                    fprintf(stderr,
                        "LEXICAL ERROR (line %d): unrecognised character '%s'\n",
                        line_num, yytext);
                }

%%

/* ================================================================
   SECTION 3 -- SUBROUTINES
   ================================================================ */

int yywrap(void) {
    return 1;   /* signal end of input */
}
