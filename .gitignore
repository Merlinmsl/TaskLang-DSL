# ================================================================
# .gitignore — TaskLang++
# SE2052 Programming Paradigms
# ================================================================
# This file tells Git which files to IGNORE and NOT track.
# These are files that are either generated automatically during
# the build process or are specific to your local machine setup.
# They should never be pushed to the repository because:
#   - Generated files can always be recreated by running make
#   - Editor/OS files are personal to your machine
# ================================================================


# ----------------------------------------------------------------
# GENERATED BY BISON (from parser.y)
# These are created automatically when you run: bison -d parser.y
# ----------------------------------------------------------------
parser.tab.c
parser.tab.h

# Also ignore if using classic Yacc naming (yacc -d produces these)
y.tab.c
y.tab.h
y.output


# ----------------------------------------------------------------
# GENERATED BY FLEX (from lexer.l)
# Created automatically when you run: flex lexer.l
# ----------------------------------------------------------------
lex.yy.c


# ----------------------------------------------------------------
# COMPILED EXECUTABLE
# Created when you run: gcc -o tasklang ...
# This is a binary file — platform specific, never commit binaries
# ----------------------------------------------------------------
tasklang
tasklang.exe


# ----------------------------------------------------------------
# COMPILED OBJECT FILES
# Intermediate files created by gcc during compilation
# ----------------------------------------------------------------
*.o
*.a
*.so


# ----------------------------------------------------------------
# BISON DEBUG / REPORT FILES
# Created when bison runs with --report or --verbose flags
# ----------------------------------------------------------------
*.output
parser.output


# ----------------------------------------------------------------
# MAKE GENERATED FILES
# ----------------------------------------------------------------
.deps


# ----------------------------------------------------------------
# WINDOWS / WSL SPECIFIC
# Zone.Identifier files are created by Windows when you copy files
# from the internet or between drives into WSL
# (You likely already have some of these in your folder)
# ----------------------------------------------------------------
*.Zone.Identifier
*:Zone.Identifier
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# ----------------------------------------------------------------
# MACOS SPECIFIC
# ----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*


# ----------------------------------------------------------------
# LINUX SPECIFIC
# ----------------------------------------------------------------
*~
.nfs*


# ----------------------------------------------------------------
# VS CODE EDITOR FILES
# These are your personal editor settings — other people
# using different editors do not need these
# ----------------------------------------------------------------
.vscode/
*.code-workspace


# ----------------------------------------------------------------
# OTHER COMMON EDITOR AND IDE FILES
# ----------------------------------------------------------------
.idea/
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp


# ----------------------------------------------------------------
# LOGS AND CRASH FILES
# ----------------------------------------------------------------
*.log
core
core.*


# ----------------------------------------------------------------
# WHAT IS NOT IGNORED (these WILL be tracked by Git):
# ----------------------------------------------------------------
# lexer.l          — your source code, must be committed
# parser.y         — your source code, must be committed
# Makefile         — build instructions, must be committed
# tests/*.tl       — test input files, must be committed
# README.md        — documentation, must be committed
# LICENSE          — license file, must be committed
# .gitignore       — this file itself, must be committed
# ----------------------------------------------------------------
